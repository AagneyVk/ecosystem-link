<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core sensor + networking permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Background execution model -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Requested defensively for a future location capability; not used
         by any capability registered in Version 1. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".EcosystemApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EcosystemAgent"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- usesCleartextTraffic is enabled because the hub is reached
             only over the private VPN mesh (ws:// not wss://), per the
             networking model's LAN-equivalence assumption. If a future
             version terminates TLS at the hub, this can be tightened via
             a network_security_config restricting cleartext to the VPN
             subnet only. -->

        <activity
            android:name=".ui.CompanionActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.EcosystemAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".screen.ScreenCaptureActivity" android:exported="false" />

        <service
            android:name=".service.EcosystemAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.MicrophoneForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".service.CameraForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <service android:name=".screen.ScreenRecordingService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <service android:name=".screen.ScreenLiveService" android:exported="false" android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".AgentDeviceAdminReceiver"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
